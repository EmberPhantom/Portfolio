# =========================================
# EmberOS Portfolio — Environment Variables
# =========================================
# Copy this file to .env.local and fill in your keys.
# These must also be added to Vercel Settings > Environment Variables.

# 1. Supabase (Powers CMS, Analytics, Blog, and Dashboard)
# Find at: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Required for API routes (Google Photos token management)
SUPABASE_SERVICE_KEY=your_service_role_key

# 2. AI Engine (Groq SDK)
# Generate at: console.groq.com
NEXT_PUBLIC_GROQ_API_KEY=your_groq_api_key

# 3. Google Photos Integration (Phase 2)
# Create credentials at: console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Use http://localhost:3000 for local, and https://pranaychandra.dev for production
NEXT_PUBLIC_APP_URL=https://pranaychandra.dev

# 4. EmailJS (Contact Form)
# Find at: dashboard.emailjs.com
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# 5. Admin Dashboard Security
# Fixed password used to access the /dashboard route
ADMIN_DASHBOARD_PASSWORD=your_dashboard_password

# 6. Optional Integrations
# GitHub TOKEN (classic) for project fetching
GITHUB_TOKEN=your_github_token
# Wakatime API Key for coding stats
NEXT_PUBLIC_WAKATIME_API_KEY=your_wakatime_key