# ========================================================
# EmberOS — Example Environment Variables
# ========================================================
# Copy this file to .env.local and fill in your keys.
# NO sensitive values are committed to the public repo.

# ---- Supabase (supabase.com) ----
# Required for Dashboard, Analytics, and Content Management
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ---- Groq AI Engine (console.groq.com) ----
# Required for the Intelligence Hub and AI Writing Assistant
# NOTE: Renamed from NEXT_PUBLIC_GROQ_API_KEY for security (v4.7)
GROQ_API_KEY=gsk_your_groq_key_here

# ---- GitHub Pulse (Optional) ----
# Required for the Omni-Intelligence sync to track your code activity
NEXT_PUBLIC_GITHUB_USERNAME=your-username
GITHUB_TOKEN=your-github-personal-access-token

# ---- EmailJS (emailjs.com) ----
# Required for the contact form functionality
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxx
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=xxxxx

# ---- Google Cloud Photo Hub (Phase 2 - Optional) ----
# Required to bridge Google Photos and Google Drive to your portfolio
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Status & Telemetry (Optional) ----
# NOTE: Server-side only (v4.7)
WAKATIME_API_KEY=your_key_here
SPOTIFY_API_KEY=your_key_here

# ---- Admin Access ----
# A fixed password protection for the dashboard route
ADMIN_DASHBOARD_PASSWORD=set-a-secure-password-here